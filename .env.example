# Create a private .env from this file. Replace every placeholder before startup.
DB_USER=teacafe
DB_PASSWORD=replace_with_random_64_character_hex_password
DB_NAME=teacafe

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_random_64_character_hex_secret
BOT_TOKEN=replace_me_with_botfather_token
BOT_USERNAME=replace_with_bot_username_without_at_sign
WEBHOOK_SECRET=replace_with_random_64_character_hex_secret
MINI_APP_URL=https://food.workline.ink/

# Production HTTPS default; set false only for local plain HTTP development.
COOKIE_SECURE=true
APP_ENV=production
APP_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,https://food.workline.ink
VITE_API_URL=
SQL_ECHO=false

# 应用内限流（按身份 + 路由分桶，滑窗计数）。多副本部署时每个副本各算一份，
# 要全局限流请上 Redis 或在网关（nginx limit_req / Cloudflare）做。
RATE_LIMIT_ENABLED=true
